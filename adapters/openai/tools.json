              "minLength": 1,
              "maxLength": 20000
            },
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            },
            "boundary_reviewed": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "adjacent_sources_checked": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "required": [
                  "start",
                  "end",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "utterances": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
