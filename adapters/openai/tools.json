                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20000
                        },
                        "uncertainty": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 20000
