{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1"
      ]
    },
    "meeting_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "boundary_reviewed": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "adjacent_sources_checked": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "start",
          "end",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "utterances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                },
                "speaker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "uncertainty": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                }
              },
              "required": [
                "id",
                "start",
                "end",
                "speaker",
                "text",
                "uncertainty"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 5000
          }
        },
        "required": [
          "id",
          "label",
          "utterances"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "meeting_id",
    "title",
    "start",
    "end",
    "boundary_reviewed",
    "adjacent_sources_checked",
    "exclusions",
    "gaps",
    "sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rock evidence 0.1"
}
